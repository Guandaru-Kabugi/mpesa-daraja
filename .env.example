# Copy to .env and fill in real values:
#   cp .env.example .env && nano .env && chmod 600 .env
# .env is gitignored. Never commit it.
#
# Names use underscores, not hyphens: Docker Compose can only substitute ${NAME} when NAME is
# letters, digits and _, and a shell can't `export` a name with a hyphen in it.

# From your app on developer.safaricom.co.ke (My Apps → Keys)
CONSUMER_KEY=your-consumer-key
CONSUMER_SECRET=your-consumer-secret

# Lipa Na M-Pesa Online passkey and shortcode. 174379 is Safaricom's shared sandbox
# paybill; the sandbox passkey for it is on the Daraja "Lipa Na M-Pesa Online" simulator page.
PASSKEY=your-passkey
BUSINESS_SHORTCODE=174379

# The public HTTPS address Safaricom sends payment results to (+ /api/payments/callback).
#   Server:  https://pay.alexguandaru.dev
#   Laptop:  your current ngrok address, e.g. https://ab12-cd34.ngrok-free.app
# No trailing slash. Avoid "mpesa"/"safaricom" in the URL: Daraja rejects those.
PUBLIC_BASE_URL=https://pay.alexguandaru.dev
